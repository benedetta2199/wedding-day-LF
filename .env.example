# Copia questo file in .env.local per lo sviluppo e imposta le stesse variabili su Vercel
# (Settings → Environment Variables). .env.local NON va mai committato.

# URL della Web App di Google Apps Script (termina con /exec).
VITE_RSVP_ENDPOINT=https://script.google.com/macros/s/IL_TUO_ID/exec

# (Facoltativo) Link alla cartella Google Drive per i file troppo grandi.
VITE_PHOTOS_UPLOAD_URL=https://drive.google.com/drive/folders/IL_TUO_ID

# Dati per il regalo (se VITE_GIFT_IBAN è vuoto il riquadro del bonifico non compare).
VITE_GIFT_HOLDER=Nome Cognome
VITE_GIFT_IBAN=IT00X0000000000000000000000
